{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["*.ts", "*.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
